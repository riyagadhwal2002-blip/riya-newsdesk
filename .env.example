# Copy to .env and fill in. Never commit or share this file.

# AI writer — free key from https://aistudio.google.com (Get API key)
GEMINI_API_KEY=
# Optional, paid: only if you switch llm.provider to "anthropic" in config.yaml
ANTHROPIC_API_KEY=

# Instagram API with Instagram Login (Meta developer dashboard → your app → Instagram → API setup with Instagram login)
IG_ACCESS_TOKEN=
IG_USER_ID=

# Telegram bot for previews, alerts and /pause (create with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public web address where post images are served (Caddy + DuckDNS, see README)
PUBLIC_BASE_URL=https://yourname.duckdns.org/p
PUBLIC_DIR=/var/www/newsdesk/p

# dry_run or live (overrides config.yaml). Leave empty to use config.yaml.
NEWSDESK_MODE=
